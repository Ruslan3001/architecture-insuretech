                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="failover-note" value="&lt;b&gt;Фейловер-стратегия (уровень клиента):&lt;/b&gt;&lt;br&gt;ALB проверяет health-check каждой зоны. При отказе зоны трафик автоматически перенаправляется в следующую ближайшую живую зону (failover по гео/приоритету). RTO достигается за счёт автоматического переключения без ручных действий." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=12;" parent="1" vertex="1">
