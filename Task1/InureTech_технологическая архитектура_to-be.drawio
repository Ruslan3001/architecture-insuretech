                <mxCell id="e-mon-k8s" value="сбор метрик" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" parent="1" source="k8s3" target="monitoring" edge="1">
